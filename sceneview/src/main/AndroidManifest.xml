<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to load gltf from network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required by HapticEngine for vibrate-based haptic feedback on interaction events.
         This permission is normal (granted at install time, no user prompt required). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- SceneView requires OpenGLES 3.0 or later for 3D rendering. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="io.github.sceneview.EngineWarmUpInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>